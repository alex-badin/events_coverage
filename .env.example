# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Cohere API key — required by scripts/build_event_dataset.py for reranking candidates
# with rerank-v3.5 (always Cohere, regardless of --retriever). Also needed for query
# embedding when running with --retriever cohere (must match the stored document
# embeddings, embed-multilingual-v3.0 input_type=clustering — no local substitute).
COHERE_API_KEY=

# OpenRouter API key — required by scripts/build_event_dataset.py for embedding the
# query probes when running with --retriever qwen3 (the default). Document vectors for
# this retriever (built by scripts/backfill_embeddings_openrouter.py from
# qwen/qwen3-embedding-8b via OpenRouter) live in a sidecar on the "Neo" LAN box, not
# here — the retriever also needs SSH access to that machine (LAN/Tailscale) to score
# windows remotely (see scripts/remote/neo_qwen_retrieve.py).
OPENROUTER_API_KEY=

# SSH target for the Neo box, as user@host. Not in the repo because it is a machine
# address; only needed for --retriever qwen3. See docs/neo_box.md.
NEO_HOST=

# OpenAI API key — required by scripts/extract_framing.py, induce_narratives.py and the
# faithfulness LLM-judge. Per-message framing extraction uses model `gpt-5.5`.
OPENAI_API_KEY=
