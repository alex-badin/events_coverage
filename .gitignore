.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.env
.env.*

# Large local source data. These files stay on disk but should not be committed by accident.
news_data/*.db
news_data/*.db-shm
news_data/*.db-wal
fom_events/downloaded_reports/*.pdf

# Generated analysis outputs.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
!outputs/cache/
outputs/cache/*
!outputs/cache/.gitkeep
!outputs/dashboard_exports/
outputs/dashboard_exports/*
!outputs/dashboard_exports/.gitkeep
reports/*
!reports/.gitkeep
