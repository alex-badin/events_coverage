askmedia.news {
    @versioned path_regexp ^/versions/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/data/(index[.]json|events/[0-9a-f]{32}[.]json)$
    @hidden path /versions /versions/* /data /data/*
    route {
        handle @versioned {
            root * /var/www/coverage/releases
            uri strip_prefix /versions
            header {
                Cache-Control "public, max-age=31536000, immutable"
                match status 2xx 304
            }
            file_server {
                precompressed gzip
            }
        }
        handle @hidden {
            respond 404
        }
        handle {
            root * /var/www/coverage/current
            @entry path / /index.html
            header @entry Cache-Control "no-cache"
            @bootstrap file .bootstrap-pending
            handle @bootstrap {
                respond "Awaiting the first dashboard release." 503
            }
            handle {
                file_server {
                    precompressed gzip
                }
            }
        }
    }
}
